# Copy to .env and fill in. Never commit the real .env file.
#
# The n8n API key is only needed to deploy the workflow and to run the
# integration tests. The voice client itself does not use any key.

# Base URL of your n8n instance
N8N_BASE_URL=http://localhost:5678

# API key from n8n: Settings -> n8n API -> Generate API key
N8N_API_KEY=

# Public webhook of the voice agent (path of the "Voice Agent Webhook" node)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-agent
