# Server only. Never use NEXT_PUBLIC_ for these values.
OPENROUTER_API_KEY=
# Must end in :free. Pick an available text/chat model on OpenRouter.
OPENROUTER_MODEL=
# Generate locally with: openssl rand -hex 32
SESSION_SECRET=
# Free Upstash Redis database, REST credentials (required on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Total LLM requests across ALL visitors per UTC day.
DEMO_DAILY_REQUEST_LIMIT=100
# Optional legacy Python bridge only (not used by browser EMA).
# VOICE_PROVIDER=local
